:root {
}



.ShopSlot {
    font-size: 60px;
    width: 20%;
    height: 20%;
    background-color: rgba(76, 76, 76, 0);
    aspect-ratio: 1;
    -unity-font-style: bold;
    position: absolute;
}

.Background {
    position: absolute;
    border-top-width: 40px;
    border-left-width: 40px;
    border-right-width: 40px;
    border-bottom-width: 40px;
    width: 100%;
    height: 100%;
}
