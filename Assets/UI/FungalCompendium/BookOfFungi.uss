:root {
}

.fungalOptions {
    background-size: cover;
    aspect-ratio: auto;
    width: 165px;
    background-image: url("project://database/Assets/ArtStuff/Sprites%20&%20Icons/Paper/BookMark1.png?fileID=2800000&guid=1862552d3d65285458e3411075cec87a&type=3#BookMark1");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    right: 154px;
    height: 86px;
    align-items: center;
    justify-content: center;
    transition-duration: 0.1s;
}

.Icon {
    height: 55px;
    aspect-ratio: 1;
    top: auto;
    bottom: auto;
    right: -19px;
}

.fungalOptions:hover {
    right: 110px;
}

#MajorImage {
}

.Pages {
    background-color: rgba(0, 0, 0, 0);
    position: relative;
    width: 35%;
}

.Words {
    font-size: 32px;
    color: rgb(0, 0, 0);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
}
