<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Pause/Pause.uss?fileID=7433441132597879392&amp;guid=f3be2bd0c684b40429afdb70d822599e&amp;type=3#Pause"/>
    <ui:VisualElement name="MenuHolder" class="MenuHolder" style="flex-grow: 1;">
        <ui:VisualElement name="LeftPage" class="Pages" style="flex-grow: 1;">
            <ui:VisualElement name="KeyBinds" class="Grouping" style="flex-grow: 1;">
                <ui:Label text="Key Binds:&#10;1 : Interact / Plant Spores&#10;2 : Harves / Remove Mushroom&#10;3 : Water Mushroom&#10;4 : Apply Milk to Mushroom" name="InteractionNotes" class="Text"/>
            </ui:VisualElement>
            <ui:VisualElement name="Instructions" class="Grouping" style="flex-grow: 1;">
                <ui:Label text="Instructions:&#10;Grow mushrooms on living / once living things. &#10;&#10;Mushrooms have effects on that which they grow, so be aware that things can die and become unusable for growing mushrooms.&#10;&#10;Be warry of pests that try to prevent your progress and desecrate the Mycelium Presence.&#10;&#10;Upon noon every day a carrier owl will come for produce and to bring items you have purchased from the catolouge&#10;" name="InteractionNotes" class="Text"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="RightPage" class="Pages" style="flex-grow: 1;">
            <ui:VisualElement name="Grouping" class="Grouping" style="flex-grow: 1;">
                <ui:Button text="Main Menu" name="MainMenu" class="Buttons"/>
                <ui:Button text="Exit " name="Exit" class="Buttons"/>
                <ui:Button text="Save" name="Save" class="Buttons" style="margin-top: 31px;"/>
                <ui:Button text="Load " name="Load" class="Buttons"/>
            </ui:VisualElement>
            <ui:VisualElement name="Grouping2" class="Grouping" style="flex-grow: 1;">
                <ui:Slider label="Volume" value="42" high-value="100" name="Volume" class="Slider Text" style="width: 472px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
